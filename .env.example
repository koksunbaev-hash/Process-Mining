# One file for the whole stack. Copy to .env and fill in the two secrets.
#
#   cp .env.example .env
#   openssl rand -hex 32     # -> SECRET_KEY
#   openssl rand -hex 32     # -> PM_API_KEYS
#
# Everything else has a working default.

# ---------------------------------------------------------------- QMS ----
SECRET_KEY=change-me-generate-a-long-random-value
DEBUG=False
# `qms` is not optional: the analytics service delivers the voice transcript to
# http://qms:8000/ by container name, and Django answers 400 to any Host it was
# not told about. Add the server's IP or domain here too if you reach the QMS
# by anything other than localhost.
# Publishing through Tailscale Funnel adds one more name here - the machine's
# own address on your tailnet, which is what the browser sends as Host:
#   ALLOWED_HOSTS=127.0.0.1,localhost,qms,192.168.0.137,dt.tailXXXX.ts.net
ALLOWED_HOSTS=127.0.0.1,localhost,qms
# Forms posted over https are rejected unless the origin is listed here.
#   CSRF_TRUSTED_ORIGINS=https://dt.tailXXXX.ts.net,https://192.168.0.137
CSRF_TRUSTED_ORIGINS=

# Postgres runs as the `db` service; these values create and open the database.
DB_NAME=qms
DB_USER=qms
DB_PASSWORD=change-me

# Fill the database with demo bakery data on first start.
RUN_SEED=False

MAX_UPLOAD_SIZE_MB=10
MAX_VOICE_MESSAGE_SIZE_MB=20

# Seconds a recognised voice command waits, cancellable, before it runs itself.
# Only plain steps onto the next stage get the countdown - a jump over a stage,
# a step back or a low-confidence parse still wait for somebody to press the
# button. 0 goes back to requiring a press for everything.
VOICE_AUTOCONFIRM_SECONDS=3

# ------------------------------------------------------- process mining ----
# Also used as the token QMS presents when it pushes events. Comma-separated
# if you want more than one; the stack needs at least one.
PM_API_KEYS=change-me-generate-a-long-random-value
PM_ENVIRONMENT=prod
PM_CORS_ORIGINS=*

# ------------------------------------------------------------- exposure ----
# Host ports. Both services listen on 8000 inside their own container.
QMS_PORT=8000
PM_PORT=8001

# Interface those two ports are published on. They speak plain http, so the
# loopback keeps them off the network entirely - everything from outside
# arrives through the TLS proxy on 443/8443. Set to 0.0.0.0 only to debug from
# another machine on the LAN, and put it back afterwards.
BIND_ADDR=127.0.0.1

# Switch on once the public address is final and TLS on it works. A browser
# remembers HSTS for the whole year and ignores you taking it back.
#   SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False

# -------------------------------------------------- push-to-talk (phone) ----
# Shared secret between the phone's backend and the QMS: the backend presents
# it, the QMS checks it. The phone itself never sees it - it talks only to the
# backend, which is the whole point of the extra hop.
#   openssl rand -hex 32
PUSHTOTALK_API_TOKEN=change-me-generate-a-long-random-value

# Which QMS user a command from the phone is attributed to. Empty means the
# command arrives with no author, which is legal but leaves the audit trail
# saying nobody did it. Voice commands still wait for a human to confirm.
PUSHTOTALK_DEFAULT_USERNAME=

# Confidence stamped on a command that arrives as text. The phone's backend
# sends no score of its own, and inventing a low one would mark every correct
# command as suspicious.
PUSHTOTALK_COMMAND_CONFIDENCE=0.90

# Host port for the backend, and the TLS port the proxy publishes it on.
# 10000 is not arbitrary: Tailscale Funnel serves 443, 8443 and 10000 only.
PTT_BIND_ADDR=0.0.0.0
PTT_PORT=8002
PTT_HTTPS_PORT=10000
PTT_LOG_LEVEL=INFO
PTT_MQTT_HOST=
PTT_MQTT_PORT=8883
PTT_MQTT_USERNAME=
PTT_MQTT_PASSWORD=
PTT_MQTT_TLS=true
PTT_MQTT_TOPIC=voice/commands/recognized
PTT_MQTT_CLIENT_ID=pushtotalk-backend
PTT_MQTT_PROJECT=kms
PTT_MQTT_TIMEOUT_SECONDS=10

# ---------------------------------------------------- voice gateway / OVOS ----
# Reusable MQTT bridge. OVOS publishes recognized text to MQTT, this gateway
# routes it into one or more projects. For KMS it calls /api/pushtotalk/commands/.
VOICE_GATEWAY_API_TOKEN=change-me-generate-a-long-random-value
VOICE_GATEWAY_PROJECT=kms
VOICE_GATEWAY_MQTT_HOST=
VOICE_GATEWAY_MQTT_PORT=1883
VOICE_GATEWAY_MQTT_USERNAME=
VOICE_GATEWAY_MQTT_PASSWORD=
VOICE_GATEWAY_MQTT_TLS=false
VOICE_GATEWAY_CLIENT_ID=voice-gateway
VOICE_GATEWAY_SUBSCRIBE_TOPIC=voice/commands/recognized
VOICE_GATEWAY_KMS_COMMAND_URL=http://qms:8000/api/pushtotalk/commands/
VOICE_GATEWAY_KMS_API_TOKEN=${PUSHTOTALK_API_TOKEN}
VOICE_GATEWAY_HTTP_TIMEOUT_SECONDS=10

# ---------------------------------------------------------- integration ----
# Name this deployment reports as. Events are grouped by it, so keep it stable.
PROCESS_MINING_SOURCE=kms_bakery
PROCESS_MINING_SCHEMA_VERSION=1.0
PROCESS_MINING_BATCH_SIZE=100
PROCESS_MINING_EXPORT_INTERVAL_SECONDS=5
PROCESS_MINING_MAX_RETRIES=5
PROCESS_MINING_CONNECT_TIMEOUT=3
PROCESS_MINING_READ_TIMEOUT=15

PROCESS_MINING_TIMEOUT_SECONDS=10

# ------------------------------------------------------------ voice ----
# Signs the transcript callback (HMAC-SHA256). QMS rejects unsigned results,
# so the stack refuses to start without it.
PM_CALLBACK_SECRET=change-me-generate-a-long-random-value

# Which recogniser answers. Both containers speak the same contract - POST
# /stt?lang=xx with a WAV body - so this line is the entire switch, and the
# entire rollback.
#
#   http://stt-nemo:8080   NeMo FastConformer, bilingual Kazakh/Russian, CPU.
#                          On eight recordings from the floor the batch number
#                          survived 7 times out of 8 (Whisper: 2), and 23.3s of
#                          audio took 0.7s on four threads (Whisper: 256s).
#   http://stt:8080        OVOS + Whisper, kept for comparison.
PM_STT_URL=http://stt-nemo:8080

# Only the OVOS/Whisper container reads this - the NeMo model is bilingual and
# picks the language per utterance, which is what mixed speech needs:
# "үш жүз қырық бір на расстойку" is one sentence in two languages.
PM_STT_LANGUAGE=kk

# Threads for the NeMo container. Four is enough to run far ahead of real time
# on this hardware; it shares the host with Postgres, Django and analytics.
NEMO_THREADS=4
STT_NEMO_PORT=8081
PM_STT_SKIP_NGROK_WARNING=false

# The speech model itself is set in services/stt/mycroft.conf - the image reads
# it from there, not from the environment. Change `model` in that file to try
# base (faster) or medium (needs a GPU to stay responsive). Write the bare name:
# the plugin asserts on `whisper-`-prefixed values and refuses to start.

# Speech gets 2 of the 4 cores so a transcription cannot freeze the QMS.
STT_CPUS=2
PM_MAX_CONCURRENT_JOBS=2

# Publish STT on localhost so it can be exposed through a tunnel for Render.
# Keep STT_BIND_ADDR at 127.0.0.1 unless you deliberately want the raw STT
# service reachable on the LAN.
STT_BIND_ADDR=127.0.0.1
STT_PORT=8080

# ------------------------------------------------ digital twins / OpenTwins ----
# Зеркало канбана в цифровых двойниках оборудования (OpenTwins поверх Eclipse
# Ditto). QMS пишет текущий продукт устройства в фичу `product` его двойника
# при каждом движении карточки. Какому устройству какой двойник - поле
# twin_id в админке (Производственные устройства). Выключено по умолчанию.
# DITTO_BASE_URL - адрес Ditto API (NodePort 30525 в стандартной установке
# OpenTwins; Grafana с интерфейсом OpenTwins живёт на 30718 и не подходит).
DITTO_ENABLED=False
DITTO_BASE_URL=
DITTO_USERNAME=ditto
DITTO_PASSWORD=ditto
DITTO_TIMEOUT_SECONDS=5
