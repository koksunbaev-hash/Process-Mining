{% extends "base.html" %}
{% load static %}
{% block title %}Производственная доска{% endblock %}
{% block page_title %}Производственная доска{% endblock %}
{% block page_subtitle %}Очередь | Замес | Формовка | Расстойка | Печь | Склад | Готово{% endblock %}
{% block top_action %}<a class="primary" href="{% url 'bakery:kanban' %}">Обновить</a>{% endblock %}
{% block content %}
<script>document.body.classList.add("kanban-mode");</script>
<div class="kanban-page">
  <section class="kanban-toolbar">
    <form class="kanban-filters">
      <input name="q" value="{{ request.GET.q }}" placeholder="Общий поиск">
      <select name="product"><option value="">Все продукты</option>{% for p in products %}<option value="{{ p.pk }}" {% if request.GET.product == p.pk|stringformat:"s" %}selected{% endif %}>{{ p.name }}</option>{% endfor %}</select>
      <select name="status"><option value="">Все статусы</option>{% for v,l in statuses %}<option value="{{ v }}" {% if request.GET.status == v %}selected{% endif %}>{{ l }}</option>{% endfor %}</select>
      <button class="primary">Применить</button>
    </form>
  </section>


  <div data-kanban-board-shell>
    {% include "bakery/kanban_board.html" %}
  </div>
</div>
{% endblock %}
