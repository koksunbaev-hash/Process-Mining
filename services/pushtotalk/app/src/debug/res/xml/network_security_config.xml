<?xml version="1.0" encoding="utf-8"?>
<!--
    Только для debug-сборки: перекрывает одноимённый файл из `src/main`.

    Адрес сервера в разработке меняется часто (домашняя сеть, эмулятор, другой
    ноутбук), поэтому cleartext здесь разрешён для всех хостов — иначе смена
    `-PapiBaseUrl` требовала бы правки этого файла и давала бы неотличимую
    от «нет сети» ошибку.

    Release-сборка использует строгий вариант из `src/main/res/xml` и по-прежнему
    требует HTTPS для всех адресов, кроме явно перечисленных.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
