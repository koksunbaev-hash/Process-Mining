<?xml version="1.0" encoding="utf-8"?>
<!--
    Строгая политика для release-сборки: backend работает по HTTP только в
    локальной сети, поэтому cleartext разрешён точечно, для всех остальных
    хостов остаётся требование HTTPS.

    Добавляя новый адрес сервера в release, укажите его домен или IP здесь же —
    иначе запрос упадёт с UnknownServiceException, который на экране выглядит
    как обычное «нет соединения с сервером».

    В debug-сборке этот файл перекрывается версией из `src/debug/res/xml`,
    где cleartext разрешён для любого хоста.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Адреса сервиса в локальной сети. -->
        <domain includeSubdomains="false">192.168.0.105</domain>
        <domain includeSubdomains="false">192.168.0.168</domain>
        <!-- Хост разработчика: 10.0.2.2 — это localhost для эмулятора Android. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
