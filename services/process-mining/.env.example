# ---- Core ----
PM_ENVIRONMENT=local
PM_DEBUG=true
PM_HOST=0.0.0.0
PM_PORT=8000
PM_WORKERS=2

# ---- Security ----
# Comma-separated list. Empty = auth disabled (local dev only!)
PM_API_KEYS=dev-key-change-me
PM_CORS_ORIGINS=*

# ---- Limits ----
PM_MAX_UPLOAD_MB=64
PM_MAX_EVENTS_PER_LOG=2000000
PM_JOB_TTL_SECONDS=3600
PM_RENDER_TIMEOUT_SECONDS=60

# ---- Storage: memory | sqlite ----
PM_STORAGE_BACKEND=sqlite
PM_SQLITE_PATH=./data/pm.db
PM_ARTIFACT_DIR=./data/artifacts

# ---- Activity mapping profiles ----
PM_MAPPING_CONFIG=./config/activities.yaml

# ---- Optional voice module ----
PM_VOICE_ENABLED=false
PM_WHISPER_MODEL=turbo
PM_WHISPER_LANGUAGE=ru
